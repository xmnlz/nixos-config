default_mode "locked"
default_layout "minimal"
pane_frames false
show_startup_tips false
show_release_notes false
theme "sage"
scroll_mode_sync false
keybinds clear-defaults=true {
    locked {
        bind "Ctrl Space" { SwitchToMode "Tmux"; }
        bind "Alt n" { NewPane; }
        bind "Alt f" { ToggleFloatingPanes; }
        bind "Alt h" "Alt Left" { MoveFocusOrTab "Left"; }
        bind "Alt l" "Alt Right" { MoveFocusOrTab "Right"; }
        bind "Alt j" "Alt Down" { MoveFocus "Down"; }
        bind "Alt k" "Alt Up" { MoveFocus "Up"; }
        bind "Alt =" "Alt +" { Resize "Increase"; }
        bind "Alt -" { Resize "Decrease"; }
        bind "Alt [" { PreviousSwapLayout; }
        bind "Alt ]" { NextSwapLayout; }
    }
    tmux {
        bind "Ctrl Space" { Write 0; SwitchToMode "Locked"; }
        bind "Esc" "Enter" { SwitchToMode "Locked"; }
        bind "c" { NewTab; SwitchToMode "Locked"; }
        bind "," { SwitchToMode "RenamePane"; PaneNameInput 0; }
        bind "r" { SwitchToMode "RenameTab"; TabNameInput 0; }
        bind "&" { CloseTab; SwitchToMode "Locked"; }
        bind "n" { GoToNextTab; SwitchToMode "Locked"; }
        bind "p" { GoToPreviousTab; SwitchToMode "Locked"; }
        bind "l" { ToggleTab; SwitchToMode "Locked"; }
        bind "1" { GoToTab 1; SwitchToMode "Locked"; }
        bind "2" { GoToTab 2; SwitchToMode "Locked"; }
        bind "3" { GoToTab 3; SwitchToMode "Locked"; }
        bind "4" { GoToTab 4; SwitchToMode "Locked"; }
        bind "5" { GoToTab 5; SwitchToMode "Locked"; }
        bind "6" { GoToTab 6; SwitchToMode "Locked"; }
        bind "7" { GoToTab 7; SwitchToMode "Locked"; }
        bind "8" { GoToTab 8; SwitchToMode "Locked"; }
        bind "9" { GoToTab 9; SwitchToMode "Locked"; }
        bind "%" { NewPane "Right"; SwitchToMode "Locked"; }
        bind "\"" { NewPane "Down"; SwitchToMode "Locked"; }
        bind "x" { CloseFocus; SwitchToMode "Locked"; }
        bind "z" { ToggleFocusFullscreen; SwitchToMode "Locked"; }
        bind "!" { BreakPane; SwitchToMode "Locked"; }
        bind "o" { FocusNextPane; SwitchToMode "Locked"; }
        bind ";" { FocusLastPane; SwitchToMode "Locked"; }
        bind "Left" { MoveFocus "Left"; SwitchToMode "Locked"; }
        bind "Right" { MoveFocus "Right"; SwitchToMode "Locked"; }
        bind "Down" { MoveFocus "Down"; SwitchToMode "Locked"; }
        bind "Up" { MoveFocus "Up"; SwitchToMode "Locked"; }
        bind "{" { MovePaneBackwards; SwitchToMode "Locked"; }
        bind "}" { MovePane; SwitchToMode "Locked"; }
        bind "Space" { NextSwapLayout; SwitchToMode "Locked"; }
        bind "Ctrl Left" { Resize "Increase Left"; }
        bind "Ctrl Right" { Resize "Increase Right"; }
        bind "Ctrl Down" { Resize "Increase Down"; }
        bind "Ctrl Up" { Resize "Increase Up"; }
        bind "[" { SwitchToMode "Scroll"; }
        bind "d" { Detach; }
        bind "s" "w" {
            LaunchOrFocusPlugin "session-manager" {
                floating true
                move_to_focused_tab true
            };
            SwitchToMode "Locked"
        }
    }
    scroll {
        bind "q" "Esc" "Ctrl c" { ScrollToBottom; SwitchToMode "Locked"; }
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "Ctrl f" "PageDown" { PageScrollDown; }
        bind "Ctrl b" "PageUp" { PageScrollUp; }
        bind "Ctrl d" { HalfPageScrollDown; }
        bind "Ctrl u" { HalfPageScrollUp; }
        bind "/" { SwitchToMode "EnterSearch"; SearchInput 0; }
        bind "e" { EditScrollback; SwitchToMode "Locked"; }
    }
    search {
        bind "q" "Esc" "Ctrl c" { ScrollToBottom; SwitchToMode "Locked"; }
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "Ctrl d" { HalfPageScrollDown; }
        bind "Ctrl u" { HalfPageScrollUp; }
        bind "n" { Search "down"; }
        bind "N" { Search "up"; }
    }
    entersearch {
        bind "Ctrl c" "Esc" { SwitchToMode "Scroll"; }
        bind "Enter" { SwitchToMode "Search"; }
    }
    renametab {
        bind "Enter" { SwitchToMode "Locked"; }
        bind "Esc" "Ctrl c" { UndoRenameTab; SwitchToMode "Locked"; }
    }
    renamepane {
        bind "Enter" { SwitchToMode "Locked"; }
        bind "Esc" "Ctrl c" { UndoRenamePane; SwitchToMode "Locked"; }
    }
}
plugins {
    zjstatus location="file:@zjstatus@" {
        format_left " {tabs}"
        format_right "{mode}#[fg=#6b7280]{session} "
        mode_locked "#[fg=#6b7280]○ "
        mode_tmux "#[fg=#e8a598,bold]● "
        mode_default_to_mode "tmux"
        tab_normal "#[fg=#6b7280] {index} {focused_pane_title} "
        tab_normal_bell "#[fg=#e8a598,bold] {index} {focused_pane_title} ● "
        tab_active "#[fg=#a8c5a0]#[bg=#a8c5a0,fg=#1d1f21,bold]{index} {focused_pane_title}#[fg=#a8c5a0]"
        tab_display_count "5"
        tab_truncate_start_format "#[fg=#6b7280]‹ +{count} "
        tab_truncate_end_format "#[fg=#6b7280] +{count} ›"
    }
}
themes {
    sage {
        text_unselected {
            base "#c5c8c6"
            background "#1d1f21"
            emphasis_0 "#e8a598"
            emphasis_1 "#a8c5a0"
            emphasis_2 "#e8c99a"
            emphasis_3 "#c4a882"
        }
        text_selected {
            base "#c5c8c6"
            background "#2b2d2f"
            emphasis_0 "#e8a598"
            emphasis_1 "#a8c5a0"
            emphasis_2 "#e8c99a"
            emphasis_3 "#c4a882"
        }
        ribbon_unselected {
            base "#c5c8c6"
            background "#2b2d2f"
            emphasis_0 "#e8a598"
            emphasis_1 "#a8c5a0"
            emphasis_2 "#e8c99a"
            emphasis_3 "#c4a882"
        }
        ribbon_selected {
            base "#1d1f21"
            background "#a8c5a0"
            emphasis_0 "#e8a598"
            emphasis_1 "#1d1f21"
            emphasis_2 "#e8c99a"
            emphasis_3 "#c4a882"
        }
        table_title {
            base "#a8c5a0"
            background 0
            emphasis_0 "#e8a598"
            emphasis_1 "#a8c5a0"
            emphasis_2 "#e8c99a"
            emphasis_3 "#c4a882"
        }
        table_cell_unselected {
            base "#c5c8c6"
            background "#1d1f21"
            emphasis_0 "#e8a598"
            emphasis_1 "#a8c5a0"
            emphasis_2 "#e8c99a"
            emphasis_3 "#c4a882"
        }
        table_cell_selected {
            base "#c5c8c6"
            background "#2b2d2f"
            emphasis_0 "#e8a598"
            emphasis_1 "#a8c5a0"
            emphasis_2 "#e8c99a"
            emphasis_3 "#c4a882"
        }
        list_unselected {
            base "#c5c8c6"
            background "#1d1f21"
            emphasis_0 "#e8a598"
            emphasis_1 "#a8c5a0"
            emphasis_2 "#e8c99a"
            emphasis_3 "#c4a882"
        }
        list_selected {
            base "#c5c8c6"
            background "#2b2d2f"
            emphasis_0 "#e8a598"
            emphasis_1 "#a8c5a0"
            emphasis_2 "#e8c99a"
            emphasis_3 "#c4a882"
        }
        frame_unselected {
            base "#6b7280"
            background 0
            emphasis_0 "#e8a598"
            emphasis_1 "#a8c5a0"
            emphasis_2 "#e8c99a"
            emphasis_3 0
        }
        frame_selected {
            base "#a8c5a0"
            background 0
            emphasis_0 "#e8a598"
            emphasis_1 "#a8c5a0"
            emphasis_2 "#e8c99a"
            emphasis_3 0
        }
        frame_highlight {
            base "#e8a598"
            background 0
            emphasis_0 "#e8a598"
            emphasis_1 "#e8a598"
            emphasis_2 "#e8a598"
            emphasis_3 "#e8a598"
        }
        exit_code_success {
            base "#a8c5a0"
            background 0
            emphasis_0 "#a8c5a0"
            emphasis_1 "#2b2d2f"
            emphasis_2 "#e8c99a"
            emphasis_3 "#c4a882"
        }
        exit_code_error {
            base "#e8a598"
            background 0
            emphasis_0 "#e8c99a"
            emphasis_1 0
            emphasis_2 0
            emphasis_3 0
        }
        multiplayer_user_colors {
            player_1 "#a8c5a0"
            player_2 "#e8a598"
            player_3 "#e8c99a"
            player_4 "#c4a882"
            player_5 "#c5c8c6"
            player_6 "#6b7280"
            player_7 "#a8c5a0"
            player_8 "#e8a598"
            player_9 "#e8c99a"
            player_10 "#c4a882"
        }
    }
}
